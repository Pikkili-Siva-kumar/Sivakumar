# ==============================================================================
# Flask Application Environment
# ==============================================================================
# Development:
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-change-in-production
PORT=5000

# Production Example:
# FLASK_ENV=production
# FLASK_DEBUG=0
# SECRET_KEY=generate-a-strong-random-hex-or-urlsafe-secret-key
# PORT=5000

# ==============================================================================
# CORS (Cross-Origin Resource Sharing)
# ==============================================================================
# Comma-separated allowed frontend origins.
# Development:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production Example:
# CORS_ORIGINS=https://pikkilisivakumar.com

# ==============================================================================
# Frontend Base URL (for outbound email links like password reset)
# ==============================================================================
# Development:
FRONTEND_BASE_URL=http://localhost:5173
# Production Example:
# FRONTEND_BASE_URL=https://pikkilisivakumar.com

# ==============================================================================
# MySQL Database Configuration
# ==============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sivakumar_portfolio
DB_USER=root
DB_PASSWORD=
# Optional full URI override:
# DATABASE_URL=mysql+pymysql://user:password@host:port/database?charset=utf8mb4

# Legacy compatibility aliases (optional)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=sivakumar_portfolio
MYSQL_USER=root
MYSQL_PASSWORD=

# ==============================================================================
# Google Gemini AI Configuration (Backend Only)
# ==============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ==============================================================================
# Transactional Email / SMTP Configuration
# ==============================================================================
# Keep false in development unless testing real SMTP delivery:
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_FROM=
MAIL_FROM_NAME=Siva Kumar
ADMIN_NOTIFICATION_EMAIL=
