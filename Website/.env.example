# Frontend Environment Configuration
# Local Development (points to local Flask API):
VITE_API_BASE_URL=http://localhost:5000/api

# Production Deployment Example:
# VITE_API_BASE_URL=https://api.pikkilisivakumar.com/api
#
# IMPORTANT:
# Never store backend secrets (such as GEMINI_API_KEY, SMTP passwords,
# database credentials, or SECRET_KEY) in frontend VITE_* environment variables.
